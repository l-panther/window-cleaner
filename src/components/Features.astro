---
import { asset } from '../utils/paths';
---

<section class="feature-strip" id="services">
  <div class="wrap feature-grid">
    <div class="feature-card" style="--accent:var(--blue);">
      
      <img src={asset('assets/images/services/house.png')} alt="House logo in blue circle">  
      <h3>Residential Homes</h3>
      <p>Expert window cleaning for homes of all sizes, ensuring streak-free, sparkling windows that enhance your living space and curb appeal.</p>
    </div>
    <div class="feature-card" style="--accent:var(--navy);">
      <img src={asset('assets/images/services/commercial.png')} alt="Commercial logo in blue circle">
      <h3>Commercial Buildings</h3>
      <p>Professional window cleaning for offices and commercial spaces, providing a polished, professional appearance with minimal disruption.</p>
    </div>
    <div class="feature-card" style="--accent:var(--gold-dark);">
      <img src={asset('assets/images/services/industrial.png')} alt="Industrial logo in blue circle">
      <h3>Industrial Buildings</h3>
      <p>Specialized cleaning for large industrial and warehouse facilities, safely reaching high or hard-to-access windows for a spotless finish.</p>
    </div>
  </div>
</section>

<style>  
/* feature strip */
  .feature-strip{background:var(--grey);padding:60px 0;}
  .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
  .feature-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:30px 26px;text-align:center;border-top:3px solid var(--accent,var(--blue));transition:transform .15s ease,box-shadow .15s ease;}
  .feature-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);}
  .feature-card img{width:60px;height:60px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;}
  .feature-card h3{margin-bottom:10px;}
  .feature-card p{font-size:14.5px;}

  @media (max-width:960px){
    .feature-grid{grid-template-columns:1fr;}
  }

  @media (max-width: 600px) {
  /* Service cards */
  .feature-strip {
    padding: 42px 0;
  }

  .feature-grid {
    gap: 18px;
  }

  .feature-card {
    padding: 22px 18px;
  }

  .feature-card img {
    width: 48px;
    height: 48px;
    margin-bottom: 13px;
  }

  .feature-card h3 {
    margin-bottom: 7px;
  }

  .feature-card p {
    font-size: 12.5px;
  }
}
</style>

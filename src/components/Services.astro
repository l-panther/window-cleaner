---
import { asset } from '../utils/paths';
---

<!-- Services -->
<section id="services-list" class="services-detail">
  <div class="wrap services-layout">

    <!-- SERVICE CONTENT -->
    <div class="services-content">

      <div class="service-block">
        <p class="eyebrow">01</p>
        <h3>Residential Service</h3>
        <p>
          Our residential window cleaning service is designed
          to make your home sparkle. Using streak-free techniques
          and eco-friendly products, we ensure every window,
          frame, and sill is spotless — from single-story
          houses to multi-level homes.
        </p>
      </div>

      <div class="service-block">
        <p class="eyebrow">02</p>
        <h3>Commercial Service</h3>
        <p>
          For commercial buildings, we provide a comprehensive
          window cleaning solution tailored to your business.
          Our team works efficiently with minimal disruption,
          focused on safety, high-quality finishes, and a
          polished professional image.
        </p>
      </div>

      <div class="service-block">
        <p class="eyebrow">03</p>
        <h3>Industrial Service</h3>
        <p>
          Our industrial window cleaning service is built
          to handle large-scale facilities, warehouses,
          and factories. Equipped with specialized tools
          and safety equipment, we reach high or
          difficult-to-access windows safely.
        </p>
      </div>

    </div>

    <!-- IMAGE GALLERY -->
    <div class="services-gallery">

      <!-- LARGE IMAGE -->
      <div class="services-image-main">
        <img
          src={asset('assets/images/services/cleaning-main.webp')}
          alt="Professional window cleaning service"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- THREE SMALL IMAGES -->
      <div class="services-image-grid">

        <div class="services-image-small">
          <img
            src={asset('assets/images/services/residential.webp')}
            alt="Residential window cleaning"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="services-image-small">
          <img
            src={asset('assets/images/services/commercial.webp')}
            alt="Commercial window cleaning"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="services-image-small">
          <img
            src={asset('assets/images/services/industrial.webp')}
            alt="Industrial window cleaning"
            loading="lazy"
            decoding="async"
          />
        </div>

      </div>
    </div>

  </div>
</section>


<style>

/* ==========================================
   SERVICES SECTION
========================================== */

.services-detail {
  padding: 96px 0;
  background: linear-gradient(
    180deg,
    var(--blue-dark),
    var(--navy)
  );
  color: #fff;
}

/* ==========================================
   SERVICES LAYOUT
========================================== */

.services-detail .services-layout {
  display: grid;
  grid-template-columns:
    minmax(0, 0.9fr)
    minmax(0, 1.1fr);
  align-items: start;
  gap: 56px;
}

.services-content,
.services-gallery {
  min-width: 0;
}

/* ==========================================
   SERVICE CONTENT
========================================== */

.service-block {
  padding-bottom: 40px;
  margin-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.14);
}

.service-block:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.service-block .eyebrow {
  color: var(--gold);
}

.service-block h3 {
  color: #fff;
  font-size: 1.3rem;
}

.service-block p {
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.7;
}

/* ==========================================
   IMAGE GALLERY
========================================== */

.services-gallery {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

.services-image-main,
.services-image-small {
  overflow: hidden;
  border: 1px solid rgba(107, 163, 214, 0.2);
  border-radius: 5px;
  background: #f1f5f9;
}

/* Featured image */

.services-image-main {
  aspect-ratio: 16 / 10;
}

/* Three smaller images */

.services-image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.services-image-small {
  aspect-ratio: 4 / 3;
}

/* Images */

.services-gallery img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.4s ease;
}

/* Hover effect */

@media (hover: hover) {
  .services-gallery img:hover {
    transform: scale(1.04);
  }
}

/* ==========================================
   TABLET
========================================== */

@media (max-width: 960px) {

  .services-detail .services-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .services-image-main {
    aspect-ratio: 16 / 9;
  }

}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 600px) {

  .services-detail {
    padding: 58px 0;
  }

  .services-detail .services-layout {
    gap: 35px;
  }

  .service-block {
    padding-bottom: 28px;
    margin-bottom: 28px;
  }

  .service-block h3 {
    font-size: 1rem;
  }

  .service-block p {
    font-size: 0.85rem;
  }

  .services-gallery,
  .services-image-grid {
    gap: 8px;
  }

  .services-image-main {
    aspect-ratio: 16 / 10;
  }

  .services-image-small {
    aspect-ratio: 1 / 1;
  }

}

/* ==========================================
   REDUCED MOTION
========================================== */

@media (prefers-reduced-motion: reduce) {
  .services-gallery img {
    transition: none;
  }
}
</style>

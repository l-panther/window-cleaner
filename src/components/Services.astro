
/* -------------------------
   SERVICES LAYOUT
-------------------------- */

.services-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 3rem;
}

.services-content,
.services-gallery {
  min-width: 0;
}

/* -------------------------
   IMAGE GALLERY
-------------------------- */

.services-gallery {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

.services-image-main,
.services-image-small {
  overflow: hidden;
  border-radius: 5px;
  border: 1px solid rgba(107, 163, 214, 0.2);
  background: #f1f5f9;
}

/* Main featured image */
.services-image-main {
  aspect-ratio: 16 / 10;
}

/* Three equal images */
.services-image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.services-image-small {
  aspect-ratio: 4 / 3;
}

/* Images */
.services-gallery img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.4s ease;
}

/* Subtle hover effect */
.services-gallery img:hover {
  transform: scale(1.04);
}

/* -------------------------
   TABLET
-------------------------- */

@media (max-width: 991.98px) {
  .services-layout {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .services-image-main {
    aspect-ratio: 16 / 9;
  }
}

/* -------------------------
   MOBILE
-------------------------- */

@media (max-width: 575.98px) {
  .services-layout {
    gap: 2rem;
  }

  .services-gallery,
  .services-image-grid {
    gap: 8px;
  }

  .services-image-main {
    aspect-ratio: 16 / 10;
  }

  .services-image-small {
    aspect-ratio: 1 / 1;
  }
}

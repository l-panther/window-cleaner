---
import { asset } from '../utils/paths';
---

<section class="hero" id="home">
  <div class="wrap">
    <div>
      <p class="eyebrow hero-eyebrow">SC Window Cleaning</p>
      <h1>Crystal Clear <em>Windows</em> Every Time</h1>
      <p class="hero-sub">Residential and commercial window cleaning with streak-free results, reliable service, and attention to every detail.</p>
      <div class="hero-ctas">
        <a class="btn btn-gold" href="#contact-form">Get Quote</a>
        <a class="btn btn-outline" href="#services-list">Our Services</a>
      </div>
      <div class="trust-row">
        <div><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.3l7.1-.7Z"/></svg> 5-star rated</div>
        <div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg> Fully insured</div>
        <div><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z"/></svg> Eco-friendly products</div>
      </div>
    </div>

    <div class="hero-art">
      <img 
        src={asset('assets/images/hero/hero.png')} 
        alt="Window being clean"
        width="520"
        height="480"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  
/* ==========================================
   HERO SECTION
========================================== */

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    135deg,
    var(--navy) 0%,
    var(--blue-dark) 55%,
    var(--blue) 100%
  );
}

.hero .wrap {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns:
    minmax(0, 1.05fr)
    minmax(0, 0.95fr);
  align-items: center;
  gap: 40px;
  padding: 84px 32px 96px;
}

.hero .wrap > div {
  min-width: 0;
}

/* ==========================================
   HERO CONTENT
========================================== */

.hero-eyebrow {
  color: var(--gold);
}

.hero h1 {
  color: #fff;
}

.hero h1 em {
  color: var(--gold);
  font-style: normal;
}

.hero-sub {
  max-width: 46ch;
  margin-bottom: 28px;
  color: rgba(255, 255, 255, 0.82);
  font-size: 16.5px;
  line-height: 1.65;
}

/* ==========================================
   HERO BUTTONS
========================================== */

.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 34px;
}

/* ==========================================
   TRUST INDICATORS
========================================== */

.trust-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 26px;
  font-family: var(--font-head);
}

.trust-row div {
  display: flex;
  align-items: center;
  gap: 8px;
  color: rgba(255, 255, 255, 0.85);
  font-size: 13px;
  font-weight: 600;
}

.trust-row svg {
  flex-shrink: 0;
  color: var(--gold);
}

/* ==========================================
   HERO IMAGE
========================================== */

.hero-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.hero-art img {
  display: block;
  width: 100%;
  max-width: 520px;
  height: auto;
  object-fit: contain;
}

/* ==========================================
   TABLET
========================================== */

@media (max-width: 960px) {

  .hero .wrap {
    grid-template-columns: 1fr;
    gap: 0;
    padding: 70px 32px;
  }

  .hero-art {
    display: none;
  }

  .hero-sub {
    max-width: 60ch;
  }
}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 600px) {

  .hero .wrap {
    padding: 55px 20px 60px;
  }

  .hero-sub {
    font-size: 0.9rem;
    margin-bottom: 22px;
  }

  .hero-ctas {
    gap: 10px;
    margin-bottom: 26px;
  }

  .trust-row {
    gap: 12px 18px;
  }

  .trust-row div {
    font-size: 12px;
  }
}
</style>

<header>
  <div class="wrap">
    <a class="logo" href="#home">
      <svg
        class="logo-mark"
        viewBox="0 0 48 48"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="6" y="6" width="36" height="36" rx="8" fill="#2C6C99"/>
        <path
          d="M14 24h20M24 14v20"
          stroke="#fff"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <path
          d="M17 17l14 14M31 17 17 31"
          stroke="#F3B70A"
          stroke-width="2"
          stroke-linecap="round"
          opacity=".85"
        />
      </svg>

      <span class="logo-text">
        <b>SC</b>
        <span>WINDOW CLEANING</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-controls="siteNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      Menu
    </button>

    <nav id="siteNav">
      <a class="navlink" href="#home">Home</a>
      <a class="navlink" href="#about">About</a>
      <a class="navlink" href="#services-list">Our Services</a>
      <a class="btn btn-navy" href="#quote">Get A Free Quote</a>
    </nav>
  </div>
</header>


<style>
  
/* ==========================================
   HEADER
========================================== */

header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}

header .wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 16px 32px;
}

/* ==========================================
   LOGO
========================================== */

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  text-decoration: none;
}

.logo-mark {
  width: 40px;
  height: 40px;
  flex: none;
}

.logo-text b {
  display: block;
  font-family: var(--font-head);
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 0.01em;
  color: var(--navy);
}

.logo-text span {
  display: block;
  font-family: var(--font-head);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--blue);
}

/* ==========================================
   DESKTOP NAVIGATION
========================================== */

#siteNav {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-head);
}

#siteNav a.navlink {
  position: relative;
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  color: var(--navy);
  text-decoration: none;
  transition: color 0.2s ease;
}

#siteNav a.navlink:hover,
#siteNav a.navlink.is-active {
  color: var(--blue);
}

#siteNav a.navlink.is-active::after {
  content: "";
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: 4px;
  height: 2px;
  background: var(--blue);
  border-radius: 2px;
}

/* Hidden on desktop */

.menu-toggle {
  display: none;
}

/* ==========================================
   TABLET / MOBILE NAVIGATION
========================================== */

@media (max-width: 1100px) {

  header .wrap {  padding: 8px 15px; }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 9px 12px;
    background: transparent;
    border: 1px solid var(--navy);
    border-radius: 6px;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 700;
    color: var(--navy);
    cursor: pointer;
  }

  .menu-toggle:hover {
    background: var(--navy);
    color: #fff;
  }

  #siteNav {
    display: none;
  }

  #siteNav.is-open {
    display: flex;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;

    flex-direction: column;
    align-items: stretch;
    gap: 10px;

    padding: 20px 32px;
    background: #fff;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 16px 30px -18px rgba(0, 0, 0, 0.25);
  }

  #siteNav.is-open a {
    width: 100%;
  }

  #siteNav a.navlink {
    padding: 12px 14px;
  }

  /* Remove desktop underline on mobile */

  #siteNav a.navlink.is-active::after {
    display: none;
  }

  #siteNav a.navlink.is-active {
    background: rgba(44, 108, 153, 0.08);
  }
}

/* ==========================================
   SMALL MOBILE
========================================== */

@media (max-width: 600px) {

  header .wrap {
    gap: 12px;
    padding: 12px 20px;
  }

  .logo-mark {
    width: 36px;
    height: 36px;
  }

  .logo-text b {
    font-size: 18px;
  }

  .logo-text span {
    font-size: 9px;
  }

  #siteNav.is-open {
    padding: 16px 20px 20px;
  }
}
</style>


<script is:inline>
  const menuToggle = document.getElementById("menuToggle");
  const siteNav = document.getElementById("siteNav");

  if (menuToggle && siteNav) {
    let isNavigating = false;
    let navigationTimer;
    const navLinks = siteNav.querySelectorAll(".navlink");

    function closeMenu() {
      siteNav.classList.remove("is-open");
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.textContent = "Menu";
    }

    // Update active navigation link
    function setActiveLink(id) {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute("href") === `#${id}`;

        link.classList.toggle("is-active", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    // Toggle mobile menu
    menuToggle.addEventListener("click", () => {
      const isOpen = siteNav.classList.toggle("is-open");

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.textContent = isOpen ? "Close" : "Menu";
    });

    // Handle navigation clicks
    siteNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.getAttribute("href")?.replace("#", "");
    
        if (id) {
          // Prevent scrolling from overriding the clicked link
          isNavigating = true;
    
          // Immediately highlight the selected link
          setActiveLink(id);
    
          // Clear any previous navigation timer
          clearTimeout(navigationTimer);
    
          // Resume scroll detection after smooth scrolling
          navigationTimer = setTimeout(() => {
            isNavigating = false;
            updateActiveOnScroll();
          }, 1000);
        }
    
        closeMenu();
      });
    });

    // Reset menu when switching to desktop
    const desktopQuery = window.matchMedia("(min-width: 1101px)");

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });

    if (desktopQuery.matches) closeMenu();

    // Automatically update active link while scrolling
    const sections = [...navLinks]
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    function updateActiveOnScroll() {

      // Ignore scroll events during navigation
      if (isNavigating) return;
    
      const header = document.querySelector("header");
      const scrollPosition =
        window.scrollY +
        (header?.offsetHeight ?? 0) +
        40;
      let activeSection = sections[0];
    
      sections.forEach((section) => {
        if (section.offsetTop <= scrollPosition) {
          activeSection = section;
        }
      });
    
      if (activeSection) {
        setActiveLink(activeSection.id);
      }
    }

    window.addEventListener("scroll", updateActiveOnScroll, {
      passive: true
    });

    window.addEventListener("resize", updateActiveOnScroll);

    updateActiveOnScroll();
  }
</script>

<header>
  <div class="wrap">
    <a class="logo" href="#home">
      <svg
        class="logo-mark"
        viewBox="0 0 48 48"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="6" y="6" width="36" height="36" rx="8" fill="#2C6C99"/>
        <path
          d="M14 24h20M24 14v20"
          stroke="#fff"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <path
          d="M17 17l14 14M31 17 17 31"
          stroke="#F3B70A"
          stroke-width="2"
          stroke-linecap="round"
          opacity=".85"
        />
      </svg>

      <span class="logo-text">
        <b>SC</b>
        <span>WINDOW CLEANING</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      id="menuToggle"
      type="button"
      aria-controls="siteNav"
      aria-expanded="false"
    >
      Menu
    </button>

    <nav id="siteNav">
      <a class="navlink" href="#home">Home</a>
      <a class="navlink" href="#about">About</a>
      <a class="navlink" href="#services-list">Our Services</a>
      <a class="btn btn-navy" href="#quote">Get A Free Quote</a>
    </nav>
  </div>
</header>
<script>
  const menuToggle = document.getElementById("menuToggle");
  const siteNav = document.getElementById("siteNav");

  if (menuToggle && siteNav) {
    let isNavigating = false;
    let navigationTimer;
    const navLinks = siteNav.querySelectorAll(".navlink");

    function closeMenu() {
      siteNav.classList.remove("is-open");
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.textContent = "Menu";
    }

    // Update active navigation link
    function setActiveLink(id) {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute("href") === `#${id}`;

        link.classList.toggle("is-active", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    // Toggle mobile menu
    menuToggle.addEventListener("click", () => {
      const isOpen = siteNav.classList.toggle("is-open");

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.textContent = isOpen ? "Close" : "Menu";
    });

    // Handle navigation clicks
    siteNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.getAttribute("href")?.replace("#", "");
    
        if (id) {
          // Prevent scrolling from overriding the clicked link
          isNavigating = true;
    
          // Immediately highlight the selected link
          setActiveLink(id);
    
          // Clear any previous navigation timer
          clearTimeout(navigationTimer);
    
          // Resume scroll detection after smooth scrolling
          navigationTimer = setTimeout(() => {
            isNavigating = false;
            updateActiveOnScroll();
          }, 1000);
        }
    
        closeMenu();
      });
    });

    // Reset menu when switching to desktop
    const desktopQuery = window.matchMedia("(min-width: 1101px)");

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });

    if (desktopQuery.matches) closeMenu();

    // Automatically update active link while scrolling
    const sections = [...navLinks]
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    function updateActiveOnScroll() {

      // Ignore scroll events during navigation
      if (isNavigating) return;
    
      const scrollPosition = window.scrollY + 150;
      let activeSection = sections[0];
    
      sections.forEach((section) => {
        if (section.offsetTop <= scrollPosition) {
          activeSection = section;
        }
      });
    
      if (activeSection) {
        setActiveLink(activeSection.id);
      }
    }

    window.addEventListener("scroll", updateActiveOnScroll, {
      passive: true
    });

    window.addEventListener("resize", updateActiveOnScroll);

    updateActiveOnScroll();
  }
</script>
